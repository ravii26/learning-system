datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MasteryLevel {
  Unknown
  Exposed
  Understood
  CanRecall
  CanApply
  CanSolve
  CanExplain
  CanTeach
  CanCreate
}

enum FsrsState {
  New
  Learning
  Review
  Relearning
}

enum Grade {
  Again
  Hard
  Good
  Easy
}

enum SkillKind {
  area
  skill
  subskill
}

enum GoalStatus {
  draft
  active
  achieved
  abandoned
  paused
}

enum CaptureStatus {
  inbox
  triaged
  processed
  archived
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  createdAt DateTime @default(now())

  topics         Topic[]
  activityLogs   ActivityLog[]
  reviewSessions ReviewSession[]
  concepts       Concept[]
  conceptLinks   ConceptLink[]
  reviewLogs     ReviewLog[]
  sessionLogs    SessionLog[]
  topicPauses    TopicPause[]
  confusions     Confusion[]
  mistakes       Mistake[]
  skills         Skill[]
  goals          Goal[]
  goalLinks      GoalLink[]
  captures       CaptureItem[]
  notes          Note[]
  noteLinks      NoteLink[]
  practiceReps   PracticeRep[]
  artifacts      Artifact[]
  generatedLessons GeneratedLesson[]
}

model Topic {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  area            String         // Tech, Business, Finance, Creative, Personal, Other — kept as-is; skillId below is additive, not a replacement
  skillId         String?
  skill           Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  why             String?        // Required before moving to active
  depthTarget     String?        // Awareness, Working Knowledge, Proficiency, Deep, Mastery (required before active)
  status          String         // inbox, queued, active, paused, maintenance, reference, dropped
  // Soft-delete only — DELETE /api/topics/[id] sets this instead of
  // removing the row. Concept/ReviewLog/SessionLog/etc. all cascade off
  // Topic; a hard delete would have taken a year of FSRS history with it
  // on one misclick. Every read path that lists or looks up a user's
  // topics filters deletedAt: null (see src/app/api/topics/**).
  deletedAt       DateTime?
  progressPct     Int            @default(0) // 0-100
  currentStage    String         // Define, Map, Fundamentals, Core Knowledge, Application, Advanced, Proof
  lastCompleted   String?
  nextAction      String?        // Required for active or paused
  startedDate     DateTime?
  lastTouchedDate DateTime       @default(now()) @updatedAt
  proofOfLearning String?
  resources       Json?          // List of link/text resources: [{title, type, url, purpose, status, notes}]
  subtasks        Json?          // List of checklist subtasks: [{id, title, completed, createdAt}]
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Advanced learning science structures
  contract        Json?          // { estimatedEffort, successCriterion, currentLevel, prerequisites: [{ title, status }] }
  // Concept is now the source of truth (see Concept model below). This JSON
  // is a generated mirror, kept in sync by src/lib/conceptSync.ts so the
  // pre-migration UI (KnowledgeMap.tsx, KnowledgeGraph.tsx) keeps working
  // unchanged. Do not hand-edit; write Concept rows and re-sync instead.
  knowledgeMap    Json?          // { concepts: [{ id, title, parentId, status, difficulty, importance }] }
  // Below: mirrors of their respective row tables, kept in sync the same
  // way knowledgeMap<->Concept is (src/lib/conceptSync.ts and its sibling
  // sync modules). Do not hand-edit; write rows and re-sync instead.
  confusions      Json?          // [{ id, text, resolved, resolvedAt, answer }]
  mistakes        Json?          // [{ id, concept, mistake, whyMade, correctUnderstanding, example, howToAvoid, createdAt }]
  pauseHistory    Json?          // [{ id, pausedAt, resumedAt, reason, completedConcepts, currentConcept, openQuestion, reactivationScore }]
  activeSlotType  String?        // 'primary' | 'secondary' | null
  sessionLogs     Json?          // [{ id, activityType, whatDone, oneInsight, whatWasHard, nextAction, durationMinutes, moduleId?, timestamp }]
  topicMode       String?        // 'self_directed' | 'course' — the existing self-directed/course toggle, untouched
  // syllabus | practice | accretion | reference — see the project plan's
  // Part 3. Not yet settable from any UI (that's Phase 8/9); exists so
  // progressCalculator.ts can branch on it. Backfilled from topicMode:
  // self_directed/course -> syllabus, everything else -> syllabus for now.
  mode            String         @default("syllabus")
  // Practice mode only: which rubric template reps are scored against —
  // a key into src/lib/practiceRubrics.ts. Null = the default template.
  rubricTemplate  String?
  curriculum      Json?          // [{ id, order, title, estimatedMinutes, completed, completedAt, notes }]

  activityLogs    ActivityLog[]
  concepts        Concept[]
  sessionLogRows  SessionLog[]
  topicPauseRows  TopicPause[]
  confusionRows   Confusion[]
  mistakeRows     Mistake[]
  goalLinks       GoalLink[]
  // Named linkedNotes, not notes — `notes String?` above is the existing
  // plain markdown field; this is the accretion-mode Note relation.
  linkedNotes     Note[]
  practiceReps    PracticeRep[]
  artifacts       Artifact[]
  generatedLessons GeneratedLesson[]
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  fieldChanged String
  oldValue     String?
  newValue     String?
  timestamp    DateTime @default(now())
}

/// The weekly-audit snapshot. Was named ReviewLog until this migration;
/// renamed (not dropped+recreated — see the migration SQL) to free that
/// name for the new per-concept ReviewLog below.
model ReviewSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedAt     DateTime @default(now())
  topicsReviewed Json     // Snapshot of decisions made: [{topicId, title, decision}]
}

/// A concept: the atom of knowledge, promoted out of Topic.knowledgeMap's
/// JSON array into a real row so it can be scheduled by an indexed query
/// (see @@index below) instead of a full table scan in JS, and so it can
/// eventually be linked across topics (ConceptLink) and rolled into a
/// skill's mastery score.
model Concept {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  title         String
  parentId      String?
  parent        Concept?     @relation("ConceptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Concept[]    @relation("ConceptTree")

  masteryLevel  MasteryLevel @default(Unknown)
  difficultyTag String?      // 'Low' | 'Medium' | 'High' — the user's own hint, distinct from FSRS difficulty below
  importance    String?      // 'Low' | 'Medium' | 'High'

  // FSRS scheduler state
  state         FsrsState    @default(New)
  stability     Float?       // days
  difficulty    Float?       // FSRS 1..10, NOT difficultyTag
  reps          Int          @default(0)
  lapses        Int          @default(0)
  lastReview    DateTime?
  nextReview    DateTime?
  elapsedDays   Int          @default(0)
  scheduledDays Int          @default(0)
  suspended     Boolean      @default(false) // soft-removed via the knowledgeMap JSON sync; preserves review history

  // The old Math.random()-generated id from the JSON array, kept for
  // backfill idempotency and so the JSON<->row sync (src/lib/conceptSync.ts)
  // can match a concept across both representations.
  legacyId         String?
  seededFromLegacy Boolean   @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reviewLogs    ReviewLog[]
  outgoingLinks ConceptLink[] @relation("ConceptLinkFrom")
  incomingLinks ConceptLink[] @relation("ConceptLinkTo")
  mistakes      Mistake[]
  notes         Note[]
  promptedReps  PracticeRep[]

  // The due-concepts query: replaces the full-topic-scan in
  // api/review/spaced/route.ts with an indexed lookup.
  @@index([userId, suspended, nextReview])
  @@index([userId, topicId, masteryLevel])
  @@index([topicId, legacyId])
}

model ConceptLink {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromId    String
  from      Concept  @relation("ConceptLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Concept  @relation("ConceptLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String   @default("related") // related | prerequisite | contrasts | example-of
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId, kind])
  @@index([userId, toId])
}

/// Area -> Skill -> sub-skill, one self-referencing table rather than three
/// fixed levels (a 3-level tree is a trap — the levels will grow). `path`
/// is a materialized array of ancestor ids, root-first, so a subtree
/// rollup ("every skill under this one") is one indexed query
/// (`path has skillId` OR `id = skillId`) instead of a recursive CTE.
///
/// masteryScore/masteryLevel/evidenceCount/computedAt are ALL derived —
/// see src/lib/mastery.ts. Never write them from a form; targetLevel is
/// the one field a user sets directly (an aspiration, not a claim).
model Skill {
  id     String    @id @default(uuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  kind     SkillKind @default(skill)
  parentId String?
  parent   Skill?    @relation("SkillTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Skill[]   @relation("SkillTree")

  path  String[] @default([]) // ancestor ids, root-first, NOT including this skill's own id
  depth Int      @default(0)

  // Evidence-earned mastery — see src/lib/mastery.ts. computedAt is null
  // until the first recompute; a stale computedAt with no error is how a
  // partial-failure recompute is caught, so never silently skip setting it.
  masteryScore     Float         @default(0) // 0..1
  masteryLevel     MasteryLevel  @default(Unknown)
  evidenceCount    Int           @default(0)
  lastEvidenceAt   DateTime?
  computedAt       DateTime?
  masteryBreakdown Json?         // { retention, coverage, ... } — cached explanation, always shown next to the score, never just the number alone

  targetLevel MasteryLevel? // the one user-set field: an aspiration, not a claim

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics    Topic[]
  goalLinks GoalLink[]
  notes     Note[]

  @@unique([userId, slug])
  @@index([userId, parentId])
  @@index([userId, kind])
}

/// Per-concept review event, append-only — the retention dataset. Replaces
/// the interval-doubling math that used to live inline in
/// api/review/spaced/route.ts; see src/lib/fsrs.ts for the scheduler.
model ReviewLog {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId       String
  concept         Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  reviewedAt      DateTime  @default(now())
  grade           Grade
  stateBefore     FsrsState
  stateAfter      FsrsState
  stabilityBefore Float?
  stabilityAfter  Float?
  difficultyAfter Float?
  elapsedDays     Int
  scheduledDays   Int
  nextReview      DateTime

  @@index([userId, reviewedAt])
  @@index([conceptId, reviewedAt])
}

/// A timeboxed study session's debrief. Promoted out of Topic.sessionLogs
/// JSON — see src/lib/sessionLogSync.ts.
model SessionLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  activityType    String   // read_watch | write_practice | speak_converse | drill_repeat | course_module | free_explore
  whatDone        String
  oneInsight      String
  whatWasHard     String
  nextAction      String
  durationMinutes Int
  moduleId        String?
  timestamp       DateTime

  // Soft-delete only — see the note on Confusion.removed below for why the
  // array<->row sync never hard-deletes on "missing from the incoming array".
  removed         Boolean  @default(false)

  legacyId        String?
  createdAt       DateTime @default(now())

  @@index([userId, topicId, timestamp])
  @@index([userId, timestamp])
}

/// A pause/resume cycle. Promoted out of Topic.pauseHistory JSON — see
/// src/lib/topicPauseSync.ts.
model TopicPause {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId           String
  topic             Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  pausedAt          DateTime
  resumedAt         DateTime?
  reason            String?
  completedConcepts String[]  @default([]) // concept titles at the moment of pausing — a point-in-time label snapshot, not a live relation
  currentConcept    String?
  openQuestion      String?
  // Despite the name, this is a short descriptive string ("Flagged 2
  // forgotten"), not a numeric score — matches the legacy JSON shape.
  reactivationScore String?

  removed           Boolean   @default(false)

  legacyId          String?
  createdAt         DateTime  @default(now())

  @@index([userId, topicId, pausedAt])
}

/// A logged "I don't understand X" note. Promoted out of Topic.confusions
/// JSON — see src/lib/confusionSync.ts.
model Confusion {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  text       String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  answer     String?

  // Soft-delete, not hard-delete: the JSON<->row sync reconciles this
  // topic's whole confusions array on every PUT. A stale client (a second
  // tab, or a request that raced a concurrent write) sending an array that
  // doesn't yet include a just-created row must never cause that row to be
  // hard-deleted for looking "missing" — see src/lib/confusionSync.ts. The
  // explicit delete affordance in ConfusionMistakeBank.tsx still works: the
  // mirror omits removed rows, so a deleted item disappears from the UI
  // exactly as before.
  removed    Boolean   @default(false)

  legacyId   String?
  createdAt  DateTime  @default(now())

  @@index([userId, topicId, resolved])
}

/// A logged mistake. Promoted out of Topic.mistakes JSON — see
/// src/lib/mistakeSync.ts. Also written directly by api/review/spaced's
/// fail-a-review flow, which already targets a real Concept.
model Mistake {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId              String
  topic                Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  conceptId            String?
  concept              Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  // Free-text concept label from the legacy JSON's `concept` field. Kept
  // even when conceptId resolves, since not every mistake maps cleanly to
  // a Concept row (an exact-title match only — see the sync module).
  conceptLabel         String
  mistake              String
  whyMade              String?
  correctUnderstanding String?
  example              String?
  howToAvoid           String?

  // Maps to the legacy JSON's `createdAt` field. Named occurredAt here so
  // it doesn't collide with this row's own createdAt audit column below.
  occurredAt           DateTime
  removed              Boolean  @default(false) // see Confusion.removed — same race, same fix
  legacyId             String?
  createdAt            DateTime @default(now())

  @@index([userId, topicId, occurredAt])
  @@index([userId, conceptId])
}

/// A user-stated outcome ("crack a senior backend interview by June"), the
/// thing an AI-generated roadmap (api/generate-roadmap) actually decomposes
/// into — previously thrown away, flattened straight into loose Topics
/// with no record of what generated them or why. GoalLink is the join to
/// what serves the goal (Topic and/or Skill, so a topic can serve more
/// than one goal).
model Goal {
  id     String     @id @default(uuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String // e.g. roadmapTitle from the generator
  outcome    String // the user's own words — verbatim, not rephrased
  why        String?
  status     GoalStatus @default(active)
  targetDate DateTime?
  startedAt  DateTime?
  achievedAt DateTime?

  // Readiness is `criteria met / criteria total`, never a fabricated
  // percentage-with-confidence — see src/lib/goalReadiness.ts. Cached here
  // so the Today screen and goal list don't recompute it on every read;
  // readinessAt is how a stale cache after a failed recompute is caught.
  readinessMet   Int       @default(0)
  readinessTotal Int       @default(0)
  readinessAt    DateTime?
  // [{ id, label, met, topicIds }] — one entry per linked required topic
  // today (see goalReadiness.ts); schema-unstable once richer AI-authored
  // criteria exist, so this stays Json rather than its own table.
  readinessBreakdown Json?

  // Raw response from api/generate-roadmap at creation time — provenance,
  // and lets a future prompt-format change replay/diff against what was
  // actually generated. Never parsed back out for logic; display/debug only.
  roadmapRaw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links GoalLink[]

  @@index([userId, status, targetDate])
}

model GoalLink {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Exactly one of these is set — enforced in application code, not the DB
  // (Prisma/Postgres can't express an XOR constraint cleanly here).
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  skillId String?
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  weight   Float   @default(1) // contribution to readiness, once weighting is more than "all required links count equally"
  order    Int     @default(0)
  required Boolean @default(true)

  @@unique([goalId, topicId])
  @@unique([goalId, skillId])
  @@index([userId, goalId, order])
}

/// A 3-second capture: a URL, a quote, or a passing thought, filed with
/// zero decision-making at the moment it arrives — the payload for
/// accretion-mode domains (investing, politics, business — anything with
/// no syllabus, per the project plan's Example C). Sits in `inbox` until a
/// weekly triage ritual turns it into a Note, a Concept, a Topic, or
/// archives it; resultNoteId/resultConceptId/resultTopicId record which.
model CaptureItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawText      String? // the thought / quote itself
  url          String?
  title        String?
  sourceType   String? // article | video | book | podcast | conversation | thought
  sourceAuthor String?
  sourceMeta   Json? // whatever api/scrape returned for `url` — third-party shape, stays Json
  highlight    String? // the quoted passage, if any
  tags         String[] @default([])

  status      CaptureStatus @default(inbox)
  processedAt DateTime?
  // Exactly one of these is set once status leaves 'inbox' — which fate
  // this capture resolved to, per the weekly triage ritual.
  resultNoteId    String?
  resultConceptId String?
  resultTopicId   String?

  createdAt DateTime @default(now())

  notes Note[]

  @@index([userId, status, createdAt])
}

/// An atomic, linkable note — the Zettelkasten-style knowledge base for
/// accretion-mode domains. Optionally attaches to a Topic/Concept/Skill
/// (structured-learning context) and/or the CaptureItem it grew from
/// (provenance), but stands on its own otherwise: the whole point of
/// accretion mode is that most notes have no syllabus to hang off of.
model Note {
  id    String @id @default(uuid())
  userId String
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String // HTML from the existing RichTextEditor component — reused, not rebuilt
  kind  String   @default("permanent") // fleeting | literature | permanent | index
  tags  String[] @default([])

  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  conceptId String?
  concept   Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  skillId   String?
  skill     Skill?   @relation(fields: [skillId], references: [id], onDelete: SetNull)

  sourceCaptureId String?
  sourceCapture   CaptureItem? @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)

  // Resurfacing (src/lib/noteResurface.ts): when this note was last shown
  // back to you, so the same note isn't resurfaced every day.
  lastResurfacedAt DateTime?
  resurfaceCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoing NoteLink[] @relation("NoteLinkFrom")
  incoming NoteLink[] @relation("NoteLinkTo")

  @@index([userId, updatedAt])
  @@index([userId, topicId])
  @@index([userId, skillId])
  @@index([userId, tags])
}

/// One row per link, read bidirectionally (`where: OR[{fromId}, {toId}]`) —
/// two rows per link would be a consistency liability the moment one
/// delete misses its pair. Parsed from `[[Title]]` references in Note.body
/// on save; see src/lib/noteLinkSync.ts.
model NoteLink {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromId String
  from   Note   @relation("NoteLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Note   @relation("NoteLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   String @default("related")

  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([userId, toId])
}

/// A single rep of deliberate practice — a speaking rep, a writing rep,
/// whatever the topic's rubric covers. The payload for practice-mode
/// domains (project plan's Example D: English/communication — no
/// curriculum, no concepts, success is a trend, not a completion bar).
/// rubricScores keeps the raw per-dimension input for the trend UI
/// (src/lib/practiceTrend.ts); `score` is the single 0..1 rollup number
/// mastery.ts needs, computed once at write time by
/// src/lib/practiceScore.ts so mastery recompute never has to re-derive it
/// (and never has to know which dimensions are inverted).
model PracticeRep {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  promptText String
  // The concept this rep's prompt was drawn from, if any — the cross-mode
  // payoff from the plan: "prompts pulled from concepts you're currently
  // learning doubles as retrieval practice." Null for a generic prompt.
  promptConceptId String?
  promptConcept   Concept? @relation(fields: [promptConceptId], references: [id], onDelete: SetNull)

  rubricScores Json     // { [dimension]: 1..5 } raw, as entered — e.g. { fluency: 3, structure: 4, vocabulary: 2, fillers: 2 }
  invertedKeys String[] @default([]) // dimensions where a LOWER raw score is better, e.g. "fillers"
  score        Float    // 0..1 rollup — see src/lib/practiceScore.ts; this is what mastery.ts reads

  recordingUrl    String?
  transcript      String?
  aiFeedback      String?
  durationSeconds Int?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, topicId, occurredAt])
  @@index([userId, occurredAt])
}

/// Proof of learning that isn't a graded review — a shipped app, a mock
/// interview, a written thesis. Applies to any topic mode (Example A's
/// "3 mock interviews", Example B's "shipped app", Example D's practice
/// reps) though this phase only wires up the practice-mode UI for it; the
/// schema and mastery contribution are mode-agnostic.
model Artifact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  title       String
  description String?
  url         String?
  kind        String? // project | writing | presentation | mock_interview | other

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, topicId, occurredAt])
}

/// An AI-generated lesson+quiz for one curriculum module, persisted so a
/// remount doesn't re-bill the AI provider for identical content (it used
/// to live only in CurriculumView component state). Only real AI output is
/// ever stored — the canned `fallback: true` filler is never cached.
/// moduleId is the legacy per-topic random id from Topic.curriculum's JSON
/// (unique only within a topic), so uniqueness is (topicId, moduleId).
model GeneratedLesson {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  moduleId    String
  moduleTitle String
  content     Json // { title, summary, keyTakeaways, explanation, codeOrExample, quiz } — AI-shaped, stays Json
  provider    String? // aicredits | groq

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, moduleId])
  @@index([userId, topicId])
}

model SystemSetting {
  key   String @id
  value String
}
