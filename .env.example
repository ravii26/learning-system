# Copy to .env for local dev. In production (Vercel) set these in
# Project Settings -> Environment Variables. Never commit real values.

# Postgres. On Vercel with Neon: the pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/learning_os"
# Direct (non-pooled) connection used only by `prisma migrate deploy` during
# the Vercel build. Neon's Vercel integration sets this for you.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Required in production — the app refuses to start without them.
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
APP_PASSWORD=""

# AI (at least one). AICredits is tried first when both are set.
GROQ_API_KEY=""
AICREDITS_API_KEY=""
# Optional comma-separated model override for AICredits
# AICREDITS_MODELS=""

# Optional: enables POST /api/capture-hook (phone/shortcut capture). Unset = disabled.
CAPTURE_TOKEN=""
