# Copy to .env for local dev. In production (Vercel) set these in
# Project Settings -> Environment Variables. Never commit real values.

# Postgres. On Vercel with Neon: the pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/learning_os"
# Direct (non-pooled) connection used only by `prisma migrate deploy` during
# the Vercel build. Neon's Vercel integration sets this for you.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Required in production — the app refuses to start without them.
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
APP_PASSWORD=""

# Set to "true" to let anyone create an account from the sign-in page.
# Leave unset while only you use the app.
# ALLOW_SIGNUP="true"

# AI (at least one). AICredits is tried first when both are set.
GROQ_API_KEY=""
AICREDITS_API_KEY=""
# AI requests per user per day (default 100). The original owner
# workspace is exempt.
# AI_DAILY_LIMIT="100"
# Optional comma-separated model override for AICredits
# AICREDITS_MODELS=""

# Optional live resource search for fields without a curated catalogue
# (free tiers; Open Library book checks need no key). Unset = skipped.
# TAVILY_API_KEY=""
# YOUTUBE_API_KEY=""

# Optional: enables POST /api/capture-hook (phone/shortcut capture). Unset = disabled.
CAPTURE_TOKEN=""

# Stop all AI calls for the rest of the day once logged AICredits spend
# reaches this many rupees (see /usage). Unset = no cap.
AI_DAILY_BUDGET_INR=100
# Optional: override the models per tier (comma-separated, tried in order).
# AICREDITS_MODELS_PLAN=google/gemini-3.5-flash
# AICREDITS_MODELS_CONTENT=anthropic/claude-haiku-4.5
# AICREDITS_MODELS_FAST=google/gemini-3.5-flash-lite

# Optional: Google Gemini directly (free key from aistudio.google.com). Used
# after AICredits and before Groq. Free tier: daily limits, and Google may use
# prompts to improve its products, so treat it as testing/backup.
# GEMINI_API_KEY=""
# GEMINI_MODELS_PLAN=gemini-3.5-flash
# Optional: Groq models to try, in order (comma-separated).
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
